# Copy to .env.local and fill in with values from the EXISTING
# codivia-platform Firebase project (do not create a new project —
# SSO depends on reusing this exact config).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=codivia-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=codivia-platform
VITE_FIREBASE_STORAGE_BUCKET=codivia-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public Razorpay key id (safe for client bundle). The key SECRET must
# only ever live in Cloud Functions config / secret manager — never here.
VITE_RAZORPAY_KEY_ID=
