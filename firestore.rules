rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // students/{uid} — owner can read their own record and create it on
    // first sign-in, but can NEVER write paid/paymentId/enrolledAt/
    // lastOrderId themselves. Only Cloud Functions (Admin SDK, which
    // bypasses these rules) can flip those fields after verifying payment.
    match /students/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.studentId == uid
        && request.resource.data.paid == false
        && request.resource.data.paymentId == null;

      allow update: if request.auth != null
        && request.auth.uid == uid
        // Only allow updating profile fields — payment fields are immutable
        // from the client regardless of the values submitted.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'email']);

      allow delete: if false;
    }
  }
}
